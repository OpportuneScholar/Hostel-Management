# Copy this file to .env only if you want to change a setting.
# Leave MONGODB_URI commented to use the local database started by "npm run dev".
# MONGODB_URI=mongodb://127.0.0.1:27017/haven
PORT=3001
# The frontend or a reverse proxy accesses the API through localhost.
HOST=127.0.0.1
# Warden login for real use. Choose your own email and a password of 8-128 characters.
WARDEN_NAME=Hostel Warden
WARDEN_EMAIL=
WARDEN_PASSWORD=
# true = sample residents and demo login (password Haven@2026). Set false for real data.
SEED_DEMO=true
# Hosting behind a proxy (Render): TRUST_PROXY=1 and HOST=0.0.0.0
# TRUST_PROXY=1
# Set this to the full frontend origin when using a reverse proxy.
APP_ORIGIN=
